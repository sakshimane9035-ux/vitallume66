# VitalLume Backend Environment Configuration

# Port for local dev server
PORT=3001

# Device Authentication Key for ESP32 and edge nodes
DEVICE_API_KEY=vitallume_secret_device_key_2026

# Database Connection (Optional - defaults to auto in-memory fallback if not set)
# PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vitallume
# Or Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-key

# Configurable Sensor Thresholds
TEMP_COLD_THRESHOLD=16.0
TEMP_HOT_THRESHOLD=34.0
HUMIDITY_LOW_THRESHOLD=25.0
HUMIDITY_HIGH_THRESHOLD=75.0
GAS_WARNING_PPM=50.0
GAS_CRITICAL_PPM=100.0
SOUND_SHOCK_DB=75.0
RADAR_DESCENT_VELOCITY=2.0
RESPIRATION_LOW_RPM=8.0
RESPIRATION_HIGH_RPM=25.0
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
